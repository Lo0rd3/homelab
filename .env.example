# local terraform/proxmox values
# copy to .env at repo root, then load with: source .env

PROXMOX_VE_API_TOKEN="root@pam!iac=replace-me"
TF_VAR_proxmox_endpoint="https://192.168.1.1:8006/"
TF_VAR_proxmox_insecure="true"
TF_VAR_target_node_name="prox"

# DuckDNS DNS-01 credential for Ansible ACME automation.
DUCKDNS_TOKEN="replace-me"

# AdGuard Home control API credentials for managed DNS rewrites.
ADGUARD_ADMIN_USERNAME="replace-me"
ADGUARD_ADMIN_PASSWORD="replace-me"
