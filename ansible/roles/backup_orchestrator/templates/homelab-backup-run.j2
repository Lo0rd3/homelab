#!/bin/bash
# Generated by Ansible. Sources accept no remote command or path: ssh invokes
# their authorized_keys forced command, which streams one fixed export archive.
# A failed collection or validation preserves its unique staging directory for
# diagnosis; a directory is removed only after its Restic snapshot succeeds.
set -Eeuo pipefail
umask 077

readonly STAGING_DIR='{{ backup_orchestrator_staging_dir }}'
readonly CACHE_DIR='{{ backup_orchestrator_cache_dir }}'
readonly CREDENTIALS_FILE='{{ backup_orchestrator_b2_credentials_path }}'
readonly PASSWORD_FILE='{{ backup_orchestrator_restic_password_path }}'
readonly SSH_KEY='{{ backup_orchestrator_ssh_private_key_path }}'
readonly KNOWN_HOSTS_FILE='{{ backup_orchestrator_known_hosts_path }}'
readonly METRIC_FILE='{{ backup_orchestrator_metric_path }}'
readonly SOURCE_USER='{{ backup_orchestrator_source_user }}'
readonly B2_BUCKET='{{ backup_orchestrator_b2_bucket }}'
readonly MAX_ARTIFACT_BYTES='{{ backup_orchestrator_max_artifact_bytes }}'
readonly SSH_CONNECT_TIMEOUT_SECONDS='{{ backup_orchestrator_ssh_connect_timeout_seconds }}'
readonly SSH_SERVER_ALIVE_INTERVAL_SECONDS='{{ backup_orchestrator_ssh_server_alive_interval_seconds }}'
readonly SSH_SERVER_ALIVE_COUNT_MAX='{{ backup_orchestrator_ssh_server_alive_count_max }}'
current_target=unknown
current_work=
snapshot_succeeded=0
declare -A success_timestamps
declare -A failure_timestamps

{% for target in backup_orchestrator_targets %}
success_timestamps['{{ target.name }}']=0
failure_timestamps['{{ target.name }}']=0
{% endfor %}

load_metric_state() {
  local line target timestamp
  [ -f "$METRIC_FILE" ] || return 0

  while IFS= read -r line; do
    if [[ $line =~ ^homelab_backup_last_success_timestamp_seconds\{target=\"([a-z0-9-]+)\"\}\ ([0-9]+)$ ]]; then
      target=${BASH_REMATCH[1]}
      timestamp=${BASH_REMATCH[2]}
      [[ -v "success_timestamps[$target]" ]] && success_timestamps["$target"]=$timestamp
    elif [[ $line =~ ^homelab_backup_last_failure_timestamp_seconds\{target=\"([a-z0-9-]+)\"\}\ ([0-9]+)$ ]]; then
      target=${BASH_REMATCH[1]}
      timestamp=${BASH_REMATCH[2]}
      [[ -v "failure_timestamps[$target]" ]] && failure_timestamps["$target"]=$timestamp
    fi
  done < "$METRIC_FILE"
}

write_metric() {
  local status=$1 timestamp tmp
  timestamp=$(date +%s)
  if [ "$status" -eq 0 ]; then
    success_timestamps["$current_target"]=$timestamp
    failure_timestamps["$current_target"]=0
  else
    failure_timestamps["$current_target"]=$timestamp
  fi
  tmp=$(mktemp "$(dirname "$METRIC_FILE")/.homelab_backup.prom.XXXXXX")
  printf '# HELP homelab_backup_last_success_timestamp_seconds Unix timestamp of the last successful backup.\n' > "$tmp"
  printf '# TYPE homelab_backup_last_success_timestamp_seconds gauge\n' >> "$tmp"
{% for target in backup_orchestrator_targets %}
  printf 'homelab_backup_last_success_timestamp_seconds{target="{{ target.name }}"} %s\n' "${success_timestamps['{{ target.name }}']}" >> "$tmp"
{% endfor %}
  printf '# HELP homelab_backup_last_failure_timestamp_seconds Unix timestamp of the last failed backup.\n' >> "$tmp"
  printf '# TYPE homelab_backup_last_failure_timestamp_seconds gauge\n' >> "$tmp"
{% for target in backup_orchestrator_targets %}
  printf 'homelab_backup_last_failure_timestamp_seconds{target="{{ target.name }}"} %s\n' "${failure_timestamps['{{ target.name }}']}" >> "$tmp"
{% endfor %}
  install -o root -g root -m 0600 "$tmp" "$METRIC_FILE"
  rm -f "$tmp"
}

finish() {
  local status=$?
  if [ "$snapshot_succeeded" -eq 1 ] && [ -n "$current_work" ]; then
    rm -rf -- "$current_work"
  fi
  [[ -v "success_timestamps[$current_target]" ]] && write_metric "$status" || true
  exit "$status"
}

is_safe_path() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] && [[ $1 != *..* ]] && [[ $1 != *//* ]] && [[ $1 != */./* ]] && [[ $1 != */ ]]
}

is_safe_absolute_path() {
  [[ $1 =~ ^/[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] && [[ $1 != *..* ]] && [[ $1 != *//* ]] && [[ $1 != */./* ]] && [[ $1 != */ ]]
}

validate_runner_inputs() {
  is_safe_absolute_path "$STAGING_DIR" && is_safe_absolute_path "$CACHE_DIR" &&
    is_safe_absolute_path "$CREDENTIALS_FILE" && is_safe_absolute_path "$PASSWORD_FILE" &&
    is_safe_absolute_path "$SSH_KEY" && is_safe_absolute_path "$KNOWN_HOSTS_FILE" &&
    is_safe_absolute_path "$METRIC_FILE" && [[ $METRIC_FILE == *.prom ]] &&
    [[ $SOURCE_USER =~ ^[a-z_][a-z0-9_-]*$ ]] &&
    [[ $B2_BUCKET =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
    [[ $MAX_ARTIFACT_BYTES =~ ^[1-9][0-9]*$ ]] &&
    [[ $SSH_CONNECT_TIMEOUT_SECONDS =~ ^[1-9][0-9]*$ ]] &&
    [[ $SSH_SERVER_ALIVE_INTERVAL_SECONDS =~ ^[1-9][0-9]*$ ]] &&
    [[ $SSH_SERVER_ALIVE_COUNT_MAX =~ ^[1-9][0-9]*$ ]] || {
      printf 'unsafe backup runner configuration\n' >&2
      return 64
    }
}

load_b2_credentials() {
  local credentials=$1 line value account_id='' account_key=''
  [ -f "$credentials" ] && [ ! -L "$credentials" ] || return 66
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;
      B2_ACCOUNT_ID=*)
        [ -z "$account_id" ] || return 65
        value=${line#B2_ACCOUNT_ID=}
        [ -n "$value" ] && [[ $value != *$'\r'* ]] || return 65
        account_id=$value
        ;;
      B2_ACCOUNT_KEY=*)
        [ -z "$account_key" ] || return 65
        value=${line#B2_ACCOUNT_KEY=}
        [ -n "$value" ] && [[ $value != *$'\r'* ]] || return 65
        account_key=$value
        ;;
      *) return 65 ;;
    esac
  done < "$credentials"
  [ -n "$account_id" ] && [ -n "$account_key" ] || return 65
  B2_ACCOUNT_ID=$account_id
  B2_ACCOUNT_KEY=$account_key
}

validate_host_pin() {
  local host=$1 pinned_host key_type public_key extra count=0
  [ -f "$KNOWN_HOSTS_FILE" ] && [ ! -L "$KNOWN_HOSTS_FILE" ] || return 66
  while IFS=' ' read -r pinned_host key_type public_key extra; do
    [ -z "${extra:-}" ] && [ "$pinned_host" = "$host" ] &&
      [[ $key_type =~ ^(ssh-ed25519|ecdsa-sha2-nistp256|rsa-sha2-(512|256))$ ]] &&
      [[ $public_key =~ ^[A-Za-z0-9+/=]+$ ]] && count=$((count + 1))
  done < "$KNOWN_HOSTS_FILE"
  [ "$count" -eq 1 ] || { printf 'target has no unique host-key pin\n' >&2; return 65; }
}

validate_archive_members() {
  local archive=$1 member details
  [ -f "$archive" ] && [ ! -L "$archive" ] || { printf 'invalid archive\n' >&2; return 1; }
  details=$(mktemp "$current_work/.archive-details.XXXXXX")
  tar -tf "$archive" | while IFS= read -r member; do
    member=${member#./}
    member=${member%/}
    [ -z "$member" ] && continue
    is_safe_path "$member" || { printf 'unsafe archive member: %s\n' "$member" >&2; exit 1; }
  done
  tar -tvf "$archive" > "$details"
  grep -Ev '^[d-]' "$details" | grep -q . && { printf 'archive contains a non-regular entry\n' >&2; return 1; }
  LC_ALL=C tar -tf "$archive" | LC_ALL=C sort | uniq -d | grep -q . && { printf 'archive contains duplicate members\n' >&2; return 1; }
  rm -f "$details"
}

validate_manifest() {
  local payload=$1 target=$2 manifest="$payload/manifest" files="$payload/files" checksums="$payload/checksums.sha256"
  local line path hash listed_files actual_files checksum_files declared_files
  [ -f "$manifest" ] && [ -f "$files" ] && [ -f "$checksums" ] || { printf 'missing export control file\n' >&2; return 1; }
  find -P "$payload" -mindepth 1 ! -type f ! -type d -print -quit | grep -q . && { printf 'export contains a non-regular file\n' >&2; return 1; }
  [ "$(wc -l < "$manifest")" -eq 5 ] || { printf 'malformed manifest\n' >&2; return 1; }
  grep -Fxq 'format_version=1' "$manifest" && grep -Fxq "target=$target" "$manifest" && grep -Fxq 'checksum_file=checksums.sha256' "$manifest" && grep -Fxq 'files_file=files' "$manifest" && grep -Eq '^created_at=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' "$manifest" || { printf 'malformed manifest\n' >&2; return 1; }
  while IFS= read -r path || [ -n "$path" ]; do
    is_safe_path "$path" && [ -f "$payload/$path" ] || { printf 'unsafe or missing declared file\n' >&2; return 1; }
  done < "$files"
  [ -s "$files" ] && [ "$(sort -u "$files" | wc -l)" -eq "$(wc -l < "$files")" ] || { printf 'empty or duplicate file list\n' >&2; return 1; }
  checksum_files=$(mktemp "$current_work/.checksum-files.XXXXXX")
  declared_files=$(mktemp "$current_work/.declared-files.XXXXXX")
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ ^([a-fA-F0-9]{64})\ \ ([A-Za-z0-9][A-Za-z0-9._/-]*)$ ]] || { printf 'malformed checksum entry\n' >&2; return 1; }
    hash=${BASH_REMATCH[1]}
    path=${BASH_REMATCH[2]}
    is_safe_path "$path" && grep -Fxq "$path" "$files" || { printf 'malformed checksum entry\n' >&2; return 1; }
    printf '%s\n' "$path" >> "$checksum_files"
  done < "$checksums"
  [ -s "$checksum_files" ] && [ "$(LC_ALL=C sort -u "$checksum_files" | wc -l)" -eq "$(wc -l < "$checksum_files")" ] || { printf 'duplicate checksum entries\n' >&2; return 1; }
  LC_ALL=C sort "$checksum_files" > "$checksum_files.sorted"
  LC_ALL=C sort "$files" > "$declared_files"
  cmp -s "$checksum_files.sorted" "$declared_files" || { printf 'checksum file set differs from manifest\n' >&2; return 1; }
  (cd "$payload" && sha256sum -c --strict checksums.sha256)
  listed_files=$(mktemp "$current_work/.listed-files.XXXXXX")
  actual_files=$(mktemp "$current_work/.actual-files.XXXXXX")
  { printf 'manifest\nchecksums.sha256\nfiles\n'; sort "$files"; } | sort > "$listed_files"
  find "$payload" -type f -printf '%P\n' | sort > "$actual_files"
  if ! cmp -s "$listed_files" "$actual_files"; then
    printf 'unexpected export file set\n' >&2
    return 1
  fi
  rm -f "$listed_files" "$actual_files"
}

backup_target() {
  local target=$1 host=$2 prefix=$3 credentials=$4 password=$5 daily=$6 weekly=$7 monthly=$8 yearly=$9 archive payload repo
  current_target=$target
  current_work=$(mktemp -d "$STAGING_DIR/$target.XXXXXX")
  archive="$current_work/export.tar"
  payload="$current_work/export"
  repo="b2:$B2_BUCKET:$prefix"
  is_safe_path "$target" && [[ $host =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] && is_safe_path "$prefix" && is_safe_absolute_path "$credentials" && is_safe_absolute_path "$password" && [[ $daily =~ ^[0-9]+$ ]] && [[ $weekly =~ ^[0-9]+$ ]] && [[ $monthly =~ ^[0-9]+$ ]] && [[ $yearly =~ ^[0-9]+$ ]] || { printf 'unsafe backup target configuration\n' >&2; return 64; }
  validate_host_pin "$host"
  ssh -i "$SSH_KEY" -o BatchMode=yes -o ClearAllForwardings=yes -o ConnectTimeout="$SSH_CONNECT_TIMEOUT_SECONDS" -o ForwardAgent=no -o GlobalKnownHostsFile=/dev/null -o PermitLocalCommand=no -o RequestTTY=no -o ServerAliveCountMax="$SSH_SERVER_ALIVE_COUNT_MAX" -o ServerAliveInterval="$SSH_SERVER_ALIVE_INTERVAL_SECONDS" -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$KNOWN_HOSTS_FILE" "$SOURCE_USER@$host" > "$archive"
  [ "$(stat -c %s "$archive")" -le "$MAX_ARTIFACT_BYTES" ] || { printf 'export archive exceeds configured size limit\n' >&2; return 1; }
  validate_archive_members "$archive"
  mkdir "$payload"
  tar --no-same-owner --no-same-permissions -xf "$archive" -C "$payload"
  validate_manifest "$payload" "$target"
  load_b2_credentials "$credentials"
  env B2_ACCOUNT_ID="$B2_ACCOUNT_ID" B2_ACCOUNT_KEY="$B2_ACCOUNT_KEY" RESTIC_PASSWORD_FILE="$password" RESTIC_CACHE_DIR="$CACHE_DIR" restic -r "$repo" backup --tag "$target" "$payload"
  snapshot_succeeded=1
  rm -rf -- "$current_work"
  current_work=
  env B2_ACCOUNT_ID="$B2_ACCOUNT_ID" B2_ACCOUNT_KEY="$B2_ACCOUNT_KEY" RESTIC_PASSWORD_FILE="$password" RESTIC_CACHE_DIR="$CACHE_DIR" restic -r "$repo" forget --keep-daily "$daily" --keep-weekly "$weekly" --keep-monthly "$monthly" --keep-yearly "$yearly" --prune
}

validate_runner_inputs
load_metric_state
trap finish EXIT

{% for target in backup_orchestrator_targets %}
backup_target '{{ target.name }}' '{{ target.host }}' '{{ target.repository_prefix }}' '{{ backup_orchestrator_b2_credentials_path }}' '{{ backup_orchestrator_restic_password_path }}' '{{ target.retention.keep_daily }}' '{{ target.retention.keep_weekly }}' '{{ target.retention.keep_monthly }}' '{{ target.retention.keep_yearly }}'
write_metric 0
snapshot_succeeded=0
current_work=
{% endfor %}
trap - EXIT
